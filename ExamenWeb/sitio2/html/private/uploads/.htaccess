# CORRECCIÓN (CWE-434): este directorio NO debe ejecutar código.
# Antes este fichero hacía justo lo contrario (AddHandler ... .php), de modo que
# cualquier fichero subido con extensión .php se ejecutaba en el servidor.
<IfModule mod_authz_core.c>
    <FilesMatch "\.(php|phtml|phar|php[0-9])$">
        Require all denied
    </FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
    <FilesMatch "\.(php|phtml|phar|php[0-9])$">
        Deny from all
    </FilesMatch>
</IfModule>

<IfModule mod_php.c>
    php_flag engine off
</IfModule>

RemoveHandler .php .phtml .phar
RemoveType .php .phtml .phar
Options -ExecCGI -Indexes
